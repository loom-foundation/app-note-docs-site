# Keeps repositories free of secrets, OS junk, editor files, and per-user AI-agent artefacts.
# Canonical source: manifest/repo-template/.

# ── Secrets: never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ── Linux ────────────────────────────────────────────────────────────────────
*~
.directory
.Trash-*
.nfs*

# ── Editors ──────────────────────────────────────────────────────────────────
*.swp
*.swo
*.swn
.idea/
*.iml

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
# and as a symlink, which the pattern above does not match: a worktree is
# given the main checkout's dependencies rather than its own copy.
node_modules
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
.venv/

# ── AI agents ────────────────────────────────────────────────────────────────
_agents/
.agents/
.aider/
.claude/
.cline/
.codeium/
.codex/
.cody/
.continue/
.copilot/
.cursor/
.windsurf/
.zed/

# ── VitePress (build output and cache; no lockfile: builds track latest minor) ─
docs/.vitepress/dist/
docs/.vitepress/cache/
package-lock.json

# ── Brand assets (copied from loom-foundation/org by scripts/copy-brand-assets.mjs) ─
docs/.vitepress/public/favicon.svg
docs/.vitepress/public/note-loom-wordmark.svg
docs/.vitepress/public/note-loom-wordmark-inverted.svg
docs/.vitepress/public/apple-touch-icon.png

# ── Social card (drawn by scripts/render-social-card.mjs) ─
docs/.vitepress/public/note-social-card.png
